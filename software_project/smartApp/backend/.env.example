# Copy this file to .env and fill in real values.

# --- Raw pg pool (src/db.js) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartapp
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Server ---
PORT=4000

# --- Classroom hardware ---
# Shared secret that devices (RFID reader, ...) send in the X-Device-Key header.
# Generate one with: openssl rand -hex 24
DEVICE_API_KEY=replace-with-a-random-device-key

# AI teacher (Ollama). Change model here, no code edit needed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
